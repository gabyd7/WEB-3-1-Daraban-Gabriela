body {
font-family: Arial, sans-serif;
margin: 0;
background-color: #f2f2f2;
color: #222;
}

header {
    text-align: center;
    padding: 20px 0 10px;
    background: none;
    color: #222;
}

nav {
    text-align: center;
    padding: 10px 0;
    background: none;
}

nav a {
    color: #1d3557;
    text-decoration: underline;
    margin: 0 10px;
    font-weight: normal;
    font-size: 16px;
}

nav a:hover {
    color: black;
}

.tara {
    background: white;
    width: 80%;
    margin: 20px auto;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 0;
    box-shadow: none;
}

h2 {
color: #1d3557;
}

.steag {
border-collapse: collapse;
margin: 20px 0;
}

.steag td {
width: 45px;
height: 35px;
padding: 0;
}

/* STEAGUL REPUBLICII MOLDOVA */

.steag-moldova td {
    width: 45px;
    height: 35px;
    padding: 0;
}

.albastru {
    background-color: #0033A0;
}

.galben {
    background-color: #FFCC00;
    text-align: center;
}

.rosu {
    background-color: #CC092F;
}

.stema img {
    display: block;
    margin: auto;
}

/* STEAGUL NORVEGIEI */

.steag-norvegia {
    width: 330px;
    height: 240px;
    background-color: #BA0C2F;
    position: relative;
    margin: 20px 0;
}

/* Crucea albă */
.steag-norvegia::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(to right,
            transparent 0 24%,
            white 24% 38%,
            transparent 38% 100%),
        linear-gradient(to bottom,
            transparent 0 39%,
            white 39% 61%,
            transparent 61% 100%);
}

/* Crucea albastră */
.steag-norvegia::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(to right,
            transparent 0 28%,
            #00205B 28% 34%,
            transparent 34% 100%),
        linear-gradient(to bottom,
            transparent 0 44%,
            #00205B 44% 56%,
            transparent 56% 100%);
}

/* SUEDIA */

.steag-suedia {
width: 290px;
height: 105px;
}

.steag-suedia td {
width: 45px;
height: 35px;
background-color: #006AA7;
}

/* crucea galbenă verticală */
.steag-suedia tr:nth-child(1) td:nth-child(2),
.steag-suedia tr:nth-child(2) td:nth-child(2),
.steag-suedia tr:nth-child(3) td:nth-child(2) {
background-color: #FECC00;
}

/* crucea galbenă orizontală */
.steag-suedia tr:nth-child(2) td {
background-color: #FECC00;
}

/* partea albastră din dreapta crucii */
.steag-suedia tr:nth-child(2) td:nth-child(3),
.steag-suedia tr:nth-child(2) td:nth-child(4) {
background-color: #FECC00;
}


.comparativ {
    width: 80%;
    margin: 20px auto;
    border-collapse: collapse;
}

.comparativ th,
.comparativ td {
    border: 1px solid black;
    padding: 8px;
    text-align: center;
}

.comparativ th {
    background: #e6e6e6;
    color: black;
}

footer {
    text-align: center;
    padding: 15px 0;
    margin-top: 20px;
    background: none;
    color: #222;
    border-top: 1px solid #ccc;
}
