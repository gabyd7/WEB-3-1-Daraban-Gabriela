body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #fff;
    color: #333;
}


/* Meniul de sus */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 50px;

    background-color: #ffffff;
}


/* Logo */
.logo {
    font-size: 24px;
    font-weight: bold;
    color: #e67e22;
}


/* Linkurile din meniu */
nav a {
    margin: 0 10px;

    text-decoration: none;
    color: #333;
}


/* Butonul cu luna */
button {
    border: none;
    background-color: #eeeeee;

    padding: 10px;

    border-radius: 5px;

    cursor: default;
}


/* Secțiunea principală */
.hero {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 60px 50px;

    background-color: #fcfafa;
}


/* Textul din secțiunea principală */
.hero-text {
    width: 50%;
}


.hero-text h1 {
    font-size: 42px;
    margin-bottom: 20px;
}


.hero-text p {
    font-size: 18px;
    line-height: 1.6;
}


/* Butoanele */
.hero-buttons {
    margin-top: 30px;
}


.btn,
.btn-secondary {
    display: inline-block;

    padding: 12px 20px;

    margin-right: 10px;

    text-decoration: none;

    border-radius: 5px;
}


/* Buton portocaliu */
.btn {
    background-color: #e67e22;
    color: white;
}


/* Buton secundar */
.btn-secondary {
    background-color: white;
    color: #e67e22;

    border: 1px solid #e67e22;
}


/* Imaginea principală */
.hero-image {
    width: 40%;
}


.hero-image img {
    width: 100%;

    border-radius: 10px;
}


/* Secțiunea cu cele 3 funcții */
.features {
    display: flex;

    justify-content: center;

    gap: 30px;

    padding: 50px;
}


/* Card */
.card {
    width: 250px;

    padding: 25px;

    text-align: center;

    background-color: #f8f6f6;

    border-radius: 10px;
}


.card h2 {
    color: #e67e22;
}


/* Secțiunea de rețete */
.recipes {
    padding: 50px;
}


.section-title {
    text-align: center;

    font-size: 30px;
}


/* Containerul rețetelor */
.recipes-container {
    display: flex;

    justify-content: center;

    gap: 30px;

    margin-top: 30px;
}


/* Cardul unei rețete */
.recipe-card {
    width: 250px;

    background-color: rgb(248, 246, 246);

    border: 1px solid #fdfcfc;

    border-radius: 10px;

    overflow: hidden;
}


.recipe-card img {
    width: 100%;
    height: 180px;

    object-fit: cover;
}


.recipe-card h3,
.recipe-card p {
    margin-left: 15px;
}


/* Footer */
.footer {
    padding: 25px;

    text-align: center;

    background-color: #333;

    color: white;
}


/* Pentru telefoane */
@media (max-width: 700px) {

    .navbar {
        flex-direction: column;
        gap: 15px;
    }


    .hero {
        flex-direction: column;
    }


    .hero-text {
        width: 100%;
    }


    .hero-image {
        width: 100%;

        margin-top: 30px;
    }


    .features {
        flex-direction: column;
        align-items: center;
    }


    .recipes-container {
        flex-direction: column;
        align-items: center;
    }

}

/* ================= LIGHT MODE ================= */

body {
    background: #f4f8f4;
    color: #222;
    transition: background 0.3s ease, color 0.3s ease;
}

.navbar,
.card,
.recipe-card {
    background: #ffffff;
    transition: background 0.3s ease, color 0.3s ease;
}

nav a,
.card p,
.recipe-card p,
.hero p,
.footer p {
    color: #444;
    transition: color 0.3s ease;
}

.logo,
.hero h1,
.section-title,
.card h2,
.recipe-card h3 {
    color: #2e7d32;
}

.footer {
    background: #2e7d32;
    color: white;
    transition: background 0.3s ease;
}

/* ================= DARK MODE ================= */

body.dark-mode {
    background: #121212;
    color: #f5f5f5;
}

body.dark-mode .navbar {
    background: #0c0c0c;
    box-shadow: 0 2px 10px rgba(255,255,255,0.05);
}

body.dark-mode .logo,
body.dark-mode .hero h1,
body.dark-mode .section-title,
body.dark-mode .card h2,
body.dark-mode .recipe-card h3 {
    color: #7bd88f;
}

body.dark-mode nav a,

body.dark-mode .card p,
body.dark-mode .recipe-card p,
body.dark-mode .footer p {
    color: #e4e4e4;
}

body.dark-mode .card,
body.dark-mode .recipe-card {
    background: #202020;
    color: #f5f5f5;
    box-shadow: 0 5px 15px rgba(0,0,0,0.4);
}

body.dark-mode .btn {
    background: #43a047;
    color: white;
}

body.dark-mode .btn-secondary {
    border: 2px solid #7bd88f;
    color: #040404;
}

body.dark-mode .btn-secondary:hover {
    background: #43a047;
    color: white;
}

body.dark-mode .footer {
    background: z#040404;
    color: #f5f5f5;
}

body.dark-mode #themeToggle {
    background: #ffd54f;
    color: #222;
}

#themeToggle {
    background: #43a047;
    color: white;
    border: none;
    border-radius: 50%;
    width: 45px;
    height: 45px;
    cursor: pointer;
    font-size: 18px;
    transition: 0.3s;
}

#themeToggle:hover {
    transform: scale(1.1);
}